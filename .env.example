# Application
APP_ENV=development
APP_NAME=ClaimGraph PI
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL
POSTGRES_DB=claimgraph
POSTGRES_USER=claimgraph
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://claimgraph:change-me@postgres:5432/claimgraph

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_MINUTES=60
SESSION_COOKIE_NAME=cg_session
CSRF_COOKIE_NAME=cg_csrf
AUTH_TOKEN_TTL_MINUTES=30
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
FRONTEND_BASE_URL=http://localhost:5173

# Email development
EMAIL_DELIVERY_MODE=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.local
MAIL_USE_TLS=false

# Observability
LOG_LEVEL=INFO
OTEL_ENABLED=false

# Machine learning
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MODEL_ARTIFACT_DIR=artifacts/models

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
